             max=\"100\"\n                          {...field}\n                          placeholder=\"100\"\n                        />\n                      </FormControl>\n                      <FormDescription>\n                        {field.value}% do saldo da carteira será convertido\n                        automaticamente\n                      </FormDescription>\n                      <FormMessage />\n                    </FormItem>\n                  )}\n                />\n              )}\n            </>\n          )}\n        </div>\n\n        <div className=\"flex justify-end gap-3 pt-4\">\n          <Button type=\"button\" variant=\"outline\" onClick={onCancel}>\n            Cancelar\n          </Button>\n          <Button type=\"submit\">\n            {stopLossEnabled ? \"Criar Stop-Loss\" : \"Criar Alerta\"}\n          </Button>\n        </div>\n      </form>\n    </Form>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/home/heosphoros/Projects/OrthoPlus-Enterprise/apps/web/src/modules/crypto/components/TechnicalIndicators.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/heosphoros/Projects/OrthoPlus-Enterprise/apps/web/src/modules/crypto/hooks/useCrypto.ts","messages":[],"suppressedMessages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'loadData'. Either include it or remove the dependency array.","line":68,"column":6,"endLine":68,"endColumn":16,"suggestions":[{"desc":"Update the dependencies array to be: [clinicId, loadData]","fix":{"range":[2271,2281],"text":"[clinicId, loadData]"}}],"suppressions":[{"kind":"directive","justification":"data-fetching functions capture deps from closure"}]}],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/heosphoro