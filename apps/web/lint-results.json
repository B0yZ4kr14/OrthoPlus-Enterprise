rio;\n  onSubmit: (data: Inventario) => void;\n  onCancel: () => void;\n}\n\nexport function InventarioForm({\n  inventario,\n  onSubmit,\n  onCancel,\n}: InventarioFormProps) {\n  const {\n    register,\n    handleSubmit,\n    formState: { errors },\n    setValue,\n    watch,\n  } = useForm<Inventario>({\n    resolver: zodResolver(inventarioSchema) as any,\n    defaultValues: (inventario as any) || {\n      numero: `INV-${format(new Date(), \"yyyy\")}-${String(Math.floor(Math.random() * 1000)).padStart(3, \"0\")}`,\n      data: format(new Date(), \"yyyy-MM-dd\"),\n      status: \"PLANEJADO\",\n      tipo: \"GERAL\",\n      responsavel: \"\",\n      observacoes: \"\",\n    },\n  });\n\n  const tipo = watch(\"tipo\");\n\n  return (\n    <form onSubmit={handleSubmit(onSubmit)} className=\"space-y-6\">\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n        {/* Número */}\n        <div className=\"space-y-2\">\n          <Label htmlFor=\"numero\">Número do Inventário *</Label>\n          <Input\n            id=\"numero\"\n            {...register(\"numero\")}\n            className={errors.numero ? \"border-destructive\" : \"\"}\n          />\n          {errors.numero && (\n            <p className=\"text-sm text-destructive\">{errors.numero.message}</p>\n          )}\n        </div>\n\n        {/* Data */}\n        <div className=\"space-y-2\">\n          <Label htmlFor=\"data\">Data *</Label>\n          <Input\n            id=\"data\"\n            type=\"date\"\n            {...register(\"data\")}\n            className={errors.data ? \"border-destructive\" : \"\"}\n          />\n          {errors.data && (\n            <p className=\"text-sm text-destructive\">{errors.data.message}</p>\n          )}\n        </div>\n\n        {/* Tipo */}\n        <div className=\"space-y-2\">\n          <Label htmlFor=\"tipo\">Tipo de Inventário *</Label>\n          <Select\n            value={watch(\"tipo\")}\n            onValueChange={(value) => setValue(\"tipo\", value as Inventario[\"tipo\"])}\n          >\n            <SelectTrigger className={errors.tipo ? \"border-destructive\" : \"\"}>\n              <SelectValue placeholder=\"Selecione o tipo\" />\n            </SelectTrigger>\n            <SelectContent>\n              {tiposInventario.map((tipo) => (\n                <SelectItem key={tipo.value} value={tipo.value}>\n                  <div>\n                    <div className=\"font-medium\">{tipo.label}</div>\n                    <div className=\"text-xs text-muted-foreground\">\n                      {tipo.description}\n                    </div>\n                  </div>\n                </SelectItem>\n              ))}\n            </SelectContent>\n          </Select>\n          {errors.tipo && (\n            <p className=\"text-sm text-destructive\">{errors.tipo.message}</p>\n          )}\n        </div>\n\n        {/* Responsável */}\n        <div className=\"space-y-2\">\n          <Label htmlFor=\"responsavel\">Responsável *</Label>\n          <Input\n            id=\"responsavel\"\n            {...register(\"responsavel\")}\n            placeholder=\"Nome do responsável pela contagem\"\n            className={errors.responsavel ? \"border-destructive\" : \"\"}\n          />\n          {errors.responsavel && (\n            <p className=\"text-sm text-destructive\">\n              {errors.responsavel.message}\n            </p>\n          )}\n        </div>\n      </div>\n\n      {/* Informações sobre o tipo selecionado */}\n      {tipo && (\n        <div className=\"p-4 bg-primary/10 rounded-lg border border-primary/20\">\n          <p className=\"text-sm text-muted-foreground\">\n            <strong>\n              {tiposInventario.find((t) => t.value === tipo as any)?.label}:\n            </strong>{\" \"}\n            {tiposInventario.find((t) => t.value === tipo as any)?.description}\n          </p>\n        </div>\n      )}\n\n      {/* Observações */}\n      <div className=\"space-y-2\">\n        <Label htmlFor=\"observacoes\">Observações</Label>\n        <Textarea\n          id=\"observacoes\"\n          {...register(\"observacoes\")}\n          placeholder=\"Informações adicionais sobre o inventário...\"\n          rows={4}\n        />\n      </div>\n\n      {/* Actions */}\n      <div className=\"flex justify-end gap-3\">\n        <Button type=\"button\" variant=\"outline\" onClick={onCancel}>\n          Cancelar\n        </Button>\n        <Button type=\"submit\">\n          {inventario ? \"Atualizar\" : \"Criar\"} Inventário\n        </Button>\n      </div>\n    </form>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/home/heosphoros/Projects/OrthoPlus-Enterprise/apps/web/src/modules/estoque/components/InventarioPDFExport.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/heosphoros/Projects/OrthoPlus-Enterprise/apps/web/src/modules/estoque/components/MovimentacaoForm.tsx","messages":[{"ruleId":"react-hooks/incompatible-library","severity":1,"message":"Compilation Skipped: Use of incompatible library\n\nThis API returns functions which cannot be memoized without leading to stale UI. To prevent this, by default React Compiler will skip memoizing this component/hook. However, you may see issues if values from this API are passed to other components/hooks that are memoized.\n\n/home/heosphoros/Projects/OrthoPlus-Enterprise/apps/web/src/modules/estoque/components/MovimentacaoForm.tsx:61:28\n  59 |   });\n  60 |\n> 61 |   const tipoMovimentacao = form.watch(\"tipo\");\n     |                            ^^^^ React Hook Form's `useForm()` API returns a `watch()` function which cannot be memoized safely.\n  62 |   const quantidade = form.watch(\"quantidade\");\n  63 |   const valorUnitario = form.watch(\"valorUnitario\");\n  64 |","line":61,"column":28,"endLine":61,"endColumn":32}],"suppressedMessages":[],"errorCount":0,"fatalErr