\n  SelectValue,\n} from \"@orthoplus/core-ui/select\";\nimport { Calendar } from \"@orthoplus/core-ui/calendar\";\nimport {\n  Popover,\n  PopoverContent,\n  PopoverTrigger,\n} from \"@orthoplus/core-ui/popover\";\nimport { CalendarIcon } from \"lucide-react\";\nimport { format } from \"date-fns\";\nimport { ptBR } from \"date-fns/locale\";\nimport { cn } from \"@/lib/utils\";\nimport { useTratamentos } from \"@/modules/pep/hooks/useTratamentos\";\nimport { useAuth } from \"@/contexts/AuthContext\";\n\nconst tratamentoSchema = z.object({\n  titulo: z\n    .string()\n    .min(3, \"Título deve ter no mínimo 3 caracteres\")\n    .max(200, \"Título muito longo\"),\n  descricao: z\n    .string()\n    .min(10, \"Descrição deve ter no mínimo 10 caracteres\")\n    .max(5000, \"Descrição muito longa\"),\n  dente_codigo: z.string().optional(),\n  status: z.enum([\"EM_ANDAMENTO\", \"CONCLUIDO\", \"PAUSADO\", \"CANCELADO\"]),\n  data_inicio: z.date(),\n  data_conclusao: z.date().optional(),\n  valor_estimado: z.string().optional(),\n  observacoes: z.string().optional(),\n});\n\ntype TratamentoFormData = z.infer<typeof tratamentoSchema>;\n\ninterface TratamentoFormProps {\n  prontuarioId: string;\n  onSuccess: () => void;\n  onCancel: () => void;\n}\n\nexport function TratamentoForm({\n  prontuarioId,\n  onSuccess,\n  onCancel,\n}: TratamentoFormProps) {\n  const { user, clinicId } = useAuth();\n  const { createTratamento } = useTratamentos(prontuarioId, clinicId || \"\");\n\n  const {\n    register,\n    handleSubmit,\n    formState: { errors },\n    setValue,\n    watch,\n  } = useForm<TratamentoFormData>({\n    resolver: zodResolver(tratamentoSchema),\n    defaultValues: {\n      status: \"EM_ANDAMENTO\",\n      data_inicio: new Date(),\n    },\n  });\n\n  const dataInicio = watch(\"data_inicio\");\n  const dataConclusao = watch(\"data_conclusao\");\n\n  const onSubmit = async (data: TratamentoFormData) => {\n    if (!user) return;\n\n    try {\n      await createTratamento({\n        titulo: data.titulo,\n        descricao: data.descricao,\n        denteCodigo: data.dente_codigo,\n        valorEstimado: data.valor_estimado\n          ? parseFloat(data.valor_estimado)\n          : undefined,\n        dataInicio: data.data_inicio,\n        createdBy: user.id,\n      });\n\n      onSuccess();\n    } catch (error) {\n      console.error(\"Erro ao salvar tratamento:\", error);\n      // Toast já exibido pelo hook\n    }\n  };\n\n  return (\n    <form onSubmit={handleSubmit(onSubmit)} className=\"space-y-4\">\n      <div className=\"grid grid-cols-2 gap-4\">\n        <div className=\"col-span-2 space-y-2\">\n          <Label htmlFor=\"titulo\">Título do Tratamento *</Label>\n          <Input\n            id=\"titulo\"\n            placeholder=\"Ex: Implante dentário, Canal do dente 18...\"\n            {...register(\"titulo\")}\n          />\n          {errors.titulo && (\n            <p className=\"text-sm text-destructive\">{errors.titulo.message}</p>\n          )}\n        </div>\n\n        <div className=\"space-y-2\">\n          <Label htmlFor=\"dente_codigo\">Dente</Label>\n          <Input\n            id=\"dente_codigo\"\n            placeholder=\"Ex: 18, 21, 36...\"\n            {...register(\"dente_codigo\")}\n          />\n        </div>\n\n        <div className=\"space-y-2\">\n          <Label htmlFor=\"status\">Status *</Label>\n          <Select\n            defaultValue=\"EM_ANDAMENTO\"\n            // @ts-expect-error — TS2345\n            onValueChange={(value) => setValue(\"status\", value as unknown)}\n          >\n            <SelectTrigger id=\"status\">\n              <SelectValue />\n            </SelectTrigger>\n            <SelectContent>\n              <SelectItem value=\"EM_ANDAMENTO\">Em Andamento</SelectItem>\n              <SelectItem value=\"CONCLUIDO\">Concluído</SelectItem>\n              <SelectItem value=\"PAUSADO\">Pausado</SelectItem>\n              <SelectItem value=\"CANCELADO\">Cancelado</SelectItem>\n            </SelectContent>\n          </Select>\n        </div>\n\n        <div className=\"space-y-2\">\n          <Label>Data de Início *</Label>\n          <Popover>\n            <PopoverTrigger asChild>\n              <Button\n                variant=\"outline\"\n                className={cn(\n                  \"w-full justify-start text-left font-normal\",\n                  !dataInicio && \"text-muted-foreground\",\n                )}\n              >\n                <CalendarIcon className=\"mr-2 h-4 w-4\" />\n                {dataInicio\n                  ? format(dataInicio, \"PPP\", { locale: ptBR })\n                  : \"Selecione a data\"}\n              </Button>\n            </PopoverTrigger>\n            <PopoverContent className=\"w-auto p-0\">\n              <Calendar\n                mode=\"single\"\n                selected={dataInicio}\n                onSelect={(date) => date && setValue(\"data_inicio\", date)}\n                initialFocus\n              />\n            </PopoverContent>\n          </Popover>\n        </div>\n\n        <div className=\"space-y-2\">\n          <Label>Data de Conclusão</Label>\n          <Popover>\n            <PopoverTrigger asChild>\n              <Button\n                variant=\"outline\"\n                className={cn(\n                  \"w-full justify-start text-left font-normal\",\n                  !dataConclusao && \"text-muted-foreground\",\n                )}\n              >\n                <CalendarIcon className=\"mr-2 h-4 w-4\" />\n                {dataConclusao\n                  ? format(dataConclusao, \"PPP\", { locale: ptBR })\n                  : \"Selecione a data\"}\n              </Button>\n            </PopoverTrigger>\n            <PopoverContent className=\"w-auto p-0\">\n              <Calendar\n                mode=\"single\"\n                selected={dataConclusao}\n                onSelect={(date) => date && setValue(\"data_conclusao\", date)}\n                initialFocus\n              />\n            </PopoverContent>\n          </Popover>\n        </div>\n\n        <div className=\"col-span-2 space-y-2\">\n          <Label htmlFor=\"descricao\">Descrição do Tratamento *</Label>\n          <Textarea\n            id=\"descricao\"\n            placeholder=\"Descreva o tratamento, procedimentos, materiais utilizados...\"\n            rows={5}\n            {...register(\"descricao\")}\n          />\n          {errors.descricao && (\n            <p className=\"text-sm text-destructive\">\n              {errors.descricao.message}\n            </p>\n          )}\n        </div>\n\n        <div className=\"space-y-2\">\n          <Label htmlFor=\"valor_estimado\">Valor Estimado (R$)</Label>\n          <Input\n            id=\"valor_estimado\"\n            type=\"number\"\n            step=\"0.01\"\n            placeholder=\"0,00\"\n            {...register(\"valor_estimado\")}\n          />\n        </div>\n\n        <div className=\"col-span-2 space-y-2\">\n          <Label htmlFor=\"observacoes\">Observações Adicionais</Label>\n          <Textarea\n            id=\"observacoes\"\n            placeholder=\"Observações, recomendações, cuidados pós-tratamento...\"\n            rows={3}\n            {...register(\"observacoes\")}\n          />\n        </div>\n      </div>\n\n      <div className=\"flex justify-end gap-2 pt-4\">\n        <Button type=\"button\" variant=\"outline\" onClick={onCancel}>\n          Cancelar\n        </Button>\n        <Button type=\"submit\">Salvar Tratamento</Button>\n      </div>\n    </form>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/home/heosphoros/Projects/OrthoPlus-Enterprise/apps/web/src/modules/pep/components/lazy/Odontograma3DLazy.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/heosphoros/Projects/OrthoPlus-Enterprise/apps/web/src/modules/pep/components/la