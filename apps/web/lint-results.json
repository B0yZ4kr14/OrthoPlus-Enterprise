\"endereco.logradouro\">Logradouro *</Label>\n              <Input\n                id=\"endereco.logradouro\"\n                {...register(\"endereco.logradouro\")}\n                placeholder=\"Rua, Avenida, etc.\"\n                className={\n                  errors.endereco?.logradouro ? \"border-destructive\" : \"\"\n                }\n              />\n              {errors.endereco?.logradouro && (\n                <p className=\"text-sm text-destructive\">\n                  {errors.endereco.logradouro.message}\n                </p>\n              )}\n            </div>\n\n            <div className=\"space-y-2\">\n              <Label htmlFor=\"endereco.numero\">Número *</Label>\n              <Input\n                id=\"endereco.numero\"\n                {...register(\"endereco.numero\")}\n                placeholder=\"123\"\n                className={errors.endereco?.numero ? \"border-destructive\" : \"\"}\n              />\n              {errors.endereco?.numero && (\n                <p className=\"text-sm text-destructive\">\n                  {errors.endereco.numero.message}\n                </p>\n              )}\n            </div>\n\n            <div className=\"space-y-2\">\n              <Label htmlFor=\"endereco.complemento\">Complemento</Label>\n              <Input\n                id=\"endereco.complemento\"\n                {...register(\"endereco.complemento\")}\n                placeholder=\"Apto, Sala, etc.\"\n              />\n            </div>\n\n            <div className=\"space-y-2\">\n              <Label htmlFor=\"endereco.bairro\">Bairro *</Label>\n              <Input\n                id=\"endereco.bairro\"\n                {...register(\"endereco.bairro\")}\n                placeholder=\"Nome do bairro\"\n                className={errors.endereco?.bairro ? \"border-destructive\" : \"\"}\n              />\n              {errors.endereco?.bairro && (\n                <p className=\"text-sm text-destructive\">\n                  {errors.endereco.bairro.message}\n                </p>\n              )}\n            </div>\n\n            <div className=\"space-y-2\">\n              <Label htmlFor=\"endereco.cidade\">Cidade *</Label>\n              <Input\n                id=\"endereco.cidade\"\n                {...register(\"endereco.cidade\")}\n                placeholder=\"Nome da cidade\"\n                className={errors.endereco?.cidade ? \"border-destructive\" : \"\"}\n              />\n              {errors.endereco?.cidade && (\n                <p className=\"text-sm text-destructive\">\n                  {errors.endereco.cidade.message}\n                </p>\n              )}\n            </div>\n\n            <div className=\"space-y-2\">\n              <Label htmlFor=\"endereco.estado\">Estado *</Label>\n              <Input\n                id=\"endereco.estado\"\n                {...register(\"endereco.estado\")}\n                placeholder=\"SP\"\n                maxLength={2}\n                className={errors.endereco?.estado ? \"border-destructive\" : \"\"}\n              />\n              {errors.endereco?.estado && (\n                <p className=\"text-sm text-destructive\">\n                  {errors.endereco.estado.message}\n                </p>\n              )}\n            </div>\n          </div>\n        </TabsContent>\n\n        {/* Profissional */}\n        <TabsContent value=\"profissional\" className=\"space-y-4\">\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n            <div className=\"space-y-2\">\n              <Label htmlFor=\"cargo\">Cargo *</Label>\n              <Select\n                value={watch(\"cargo\")}\n                onValueChange={(value) =>\n                  setValue(\"cargo\", value as (typeof cargosDisponiveis)[number])\n                }\n              >\n                <SelectTrigger\n                  className={errors.cargo ? \"border-destructive\" : \"\"}\n                >\n                  <SelectValue placeholder=\"Selecione o cargo\" />\n                </SelectTrigger>\n                <SelectContent>\n                  {cargosDisponiveis.map((cargo) => (\n                    <SelectItem key={cargo} value={cargo}>\n                      {cargo}\n                    </SelectItem>\n                  ))}\n                </SelectContent>\n              </Select>\n              {errors.cargo && (\n                <p className=\"text-sm text-destructive\">\n                  {errors.cargo.message}\n                </p>\n              )}\n            </div>\n\n            <div className=\"space-y-2\">\n              <Label>Data de Admissão *</Label>\n              <Popover>\n                <PopoverTrigger asChild>\n                  <Button\n                    variant=\"outline\"\n                    className={cn(\n                      \"w-full justify-start text-left font-normal\",\n                      !dataAdmissao && \"text-muted-foreground\",\n                      errors.dataAdmissao && \"border-destructive\",\n                    )}\n                  >\n                    <CalendarIcon className=\"mr-2 h-4 w-4\" />\n                    {dataAdmissao\n                      ? format(new Date(dataAdmissao), \"PPP\", { locale: ptBR })\n                      : \"Selecione a data\"}\n                  </Button>\n                </PopoverTrigger>\n                <PopoverContent className=\"w-auto p-0\" align=\"start\">\n                  <Calendar\n                    mode=\"single\"\n                    selected={dataAdmissao ? new Date(dataAdmissao) : undefined}\n                    onSelect={(date) =>\n                      date &&\n                      setValue(\"dataAdmissao\", format(date, \"yyyy-MM-dd\"))\n                    }\n                    disabled={(date) => date > new Date()}\n                    initialFocus\n                    className=\"pointer-events-auto\"\n                  />\n                </PopoverContent>\n              </Popover>\n              {errors.dataAdmissao && (\n                <p className=\"text-sm text-destructive\">\n                  {errors.dataAdmissao.message}\n                </p>\n              )}\n            </div>\n\n            <div className=\"space-y-2\">\n              <Label htmlFor=\"salario\">Salário (R$) *</Label>\n              <Input\n                id=\"salario\"\n                type=\"number\"\n                step=\"0.01\"\n                {...register(\"salario\", { valueAsNumber: true })}\n                placeholder=\"0.00\"\n                className={errors.salario ? \"border-destructive\" : \"\"}\n              />\n              {errors.salario && (\n                <p className=\"text-sm text-destructive\">\n                  {errors.salario.message}\n                </p>\n              )}\n            </div>\n\n            <div className=\"space-y-2\">\n              <Label htmlFor=\"status\">Status *</Label>\n              <Select\n                value={watch(\"status\")}\n                onValueChange={(value) =>\n                  setValue(\"status\", value as Funcionario[\"status\"])\n                }\n              >\n                <SelectTrigger>\n                  <SelectValue placeholder=\"Selecione o status\" />\n                </SelectTrigger>\n                <SelectContent>\n                  <SelectItem value=\"Ativo\">Ativo</SelectItem>\n                  <SelectItem value=\"Inativo\">Inativo</SelectItem>\n                  <SelectItem value=\"Férias\">Férias</SelectItem>\n                  <SelectItem value=\"Afastado\">Afastado</SelectItem>\n                </SelectContent>\n              </Select>\n            </div>\n\n            <div className=\"md:col-span-2 space-y-2\">\n              <Label htmlFor=\"senhaAcesso\">Senha de Acesso</Label>\n              <Input\n                id=\"senhaAcesso\"\n                type=\"password\"\n                {...register(\"senhaAcesso\")}\n                placeholder=\"Senha para acesso ao sistema (mínimo 6 caracteres)\"\n              />\n              {errors.senhaAcesso && (\n                <p className=\"text-sm text-destructive\">\n                  {errors.senhaAcesso.message}\n                </p>\n              )}\n            </div>\n\n            <div className=\"md:col-span-2 space-y-2\">\n              <Label htmlFor=\"observacoes\">Observações</Label>\n              <Textarea\n                id=\"observacoes\"\n                {...register(\"observacoes\")}\n                placeholder=\"Informações adicionais sobre o funcionário...\"\n                rows={3}\n              />\n            </div>\n          </div>\n        </TabsContent>\n\n        {/* Horários */}\n        <TabsContent value=\"horarios\" className=\"space-y-4\">\n          <div className=\"space-y-4\">\n            <div className=\"space-y-2\">\n              <Label>Dias de Trabalho *</Label>\n              <div className=\"grid grid-cols-2 md:grid-cols-4 gap-2 p-4 border rounded-lg\">\n                {diasSemana.map((dia) => (\n                  <div key={dia.value} className=\"flex items-center space-x-2\">\n                    <Checkbox\n                      id={`dia-${dia.value}`}\n                      checked={selectedDias.includes(dia.value)}\n                      onCheckedChange={() => handleDiaToggle(dia.value)}\n                    />\n                    <label\n                      htmlFor={`dia-${dia.value}`}\n                      className=\"text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70 cursor-pointer\"\n                    >\n                      {dia.label}\n                    </label>\n                  </div>\n                ))}\n              </div>\n              {errors.diasTrabalho && (\n                <p className=\"text-sm text-destructive\">\n                  {errors.diasTrabalho.message}\n                </p>\n              )}\n            </div>\n\n            <div class