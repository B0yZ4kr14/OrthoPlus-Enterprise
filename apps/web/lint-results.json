ch } from \"@orthoplus/core-ui/switch\";\nimport {\n  Form,\n  FormControl,\n  FormField,\n  FormItem,\n  FormLabel,\n  FormMessage,\n  FormDescription,\n} from \"@orthoplus/core-ui/form\";\nimport {\n  Select,\n  SelectContent,\n  SelectItem,\n  SelectTrigger,\n  SelectValue,\n} from \"@orthoplus/core-ui/select\";\nimport { Tabs, TabsContent, TabsList, TabsTrigger } from \"@orthoplus/core-ui/tabs\";\nimport {\n  Card,\n  CardContent,\n  CardDescription,\n  CardHeader,\n  CardTitle,\n} from \"@orthoplus/core-ui/card\";\nimport { fornecedorSchema, type Fornecedor } from \"../types/estoque.types\";\n\ninterface FornecedorFormProps {\n  fornecedor?: Fornecedor;\n  onSubmit: (data: Fornecedor) => void;\n  onCancel: () => void;\n}\n\nexport function FornecedorForm({\n  fornecedor,\n  onSubmit,\n  onCancel,\n}: FornecedorFormProps) {\n  const form = useForm<Fornecedor>({\n    // @ts-expect-error — TS2322\n    resolver: zodResolver(fornecedorSchema),\n    defaultValues: fornecedor || {\n      nome: \"\",\n      razaoSocial: \"\",\n      cnpj: \"\",\n      email: \"\",\n      telefone: \"\",\n      endereco: \"\",\n      cidade: \"\",\n      estado: \"\",\n      cep: \"\",\n      observacoes: \"\",\n      ativo: true,\n      apiEnabled: false,\n      apiEndpoint: \"\",\n      apiAuthType: \"none\",\n      apiUsername: \"\",\n      apiPassword: \"\",\n      apiToken: \"\",\n      apiKeyHeader: \"\",\n      apiKeyValue: \"\",\n      apiRequestFormat: \"json\",\n      autoOrderEnabled: false,\n    },\n  });\n\n  return (\n    <Form {...form}>\n      {/* @ts-expect-error — TS2345 */}\n      <form onSubmit={form.handleSubmit(onSubmit)} className=\"space-y-6\">\n        <Tabs defaultValue=\"dados\" className=\"w-full\">\n          <TabsList className=\"grid w-full grid-cols-3\">\n            <TabsTrigger value=\"dados\">Dados Cadastrais</TabsTrigger>\n            <TabsTrigger value=\"api\">Integração API</TabsTrigger>\n            <TabsTrigger value=\"pedidos\">Pedidos Automáticos</TabsTrigger>\n          </TabsList>\n\n          <TabsContent value=\"dados\" className=\"space-y-6\">\n            <div className=\"grid gap-6 md:grid-cols-2\">\n              <FormField\n                // @ts-expect-error — TS2322\n                control={form.control}\n                name=\"nome\"\n                render={({ field }) => (\n                  <FormItem>\n                    <FormLabel>Nome Fantasia *</FormLabel>\n                    <FormControl>\n                      <Input placeholder=\"Nome do fornecedor\" {...field} />\n                    </FormControl>\n                    <FormMessage />\n                  </FormItem>\n                )}\n              />\n\n              <FormField\n                // @ts-expect-error — TS2322\n                control={form.control}\n                name=\"razaoSocial\"\n                render={({ field }) => (\n                  <FormItem>\n                    <FormLabel>Razão Social</FormLabel>\n                    <FormControl>\n                      <Input placeholder=\"Razão social\" {...field} />\n                    </FormControl>\n                    <FormMessage />\n                  </FormItem>\n                )}\n              />\n\n              <FormField\n                // @ts-expect-error — TS2322\n                control={form.control}\n                name=\"cnpj\"\n                render={({ field }) => (\n                  <FormItem>\n                    <FormLabel>CNPJ</FormLabel>\n                    <FormControl>\n                      <Input placeholder=\"00.000.000/0000-00\" {...field} />\n                    </FormControl>\n                    <FormMessage />\n                  </FormItem>\n                )}\n              />\n\n              <FormField\n                // @ts-expect-error — TS2322\n                control={form.control}\n                name=\"email\"\n                render={({ field }) => (\n                  <FormItem>\n                    <FormLabel>Email</FormLabel>\n                    <FormControl>\n                      <Input\n                        type=\"email\"\n                        placeholder=\"email@fornecedor.com\"\n                        {...field}\n                      />\n                    </FormControl>\n                    <FormMessage />\n                  </FormItem>\n                )}\n              />\n\n              <FormField\n                // @ts-expect-error — TS2322\n                control={form.control}\n                name=\"telefone\"\n                render={({ field }) => (\n                  <FormItem>\n                    <FormLabel>Telefone</FormLabel>\n                    <FormControl>\n                      <Input placeholder=\"(00) 00000-0000\" {...field} />\n                    </FormControl>\n                    <FormMessage />\n                  </FormItem>\n                )}\n              />\n\n              <FormField\n                // @ts-expect-error — TS2322\n                control={form.control}\n                name=\"cep\"\n                render={({ field }) => (\n                  <FormItem>\n                    <FormLabel>CEP</FormLabel>\n                    <FormControl>\n                      <Input placeholder=\"00000-000\" {...field} />\n                    </FormControl>\n                    <FormMessage />\n                  </FormItem>\n                )}\n              />\n            </div>\n\n            <FormField\n              // @ts-expect-error — TS2322\n              control={form.control}\n              name=\"endereco\"\n              render={({ field }) => (\n                <FormItem>\n                  <FormLabel>Endereço</FormLabel>\n                  <FormControl>\n                    <Input placeholder=\"Rua, número, complemento\" {...field} />\n                  </FormControl>\n                  <FormMessage />\n                </FormItem>\n              )}\n            />\n\n            <div className=\"grid gap-6 md:grid-cols-2\">\n              <FormField\n                // @ts-expect-error — TS2322\n                control={form.control}\n                name=\"cidade\"\n                render={({ field }) => (\n                  <FormItem>\n                    <FormLabel>Cidade</FormLabel>\n                    <FormControl>\n                      <Input placeholder=\"Cidade\" {...field} />\n                    </FormControl>\n                    <FormMessage />\n                  </FormItem>\n                )}\n              />\n\n              <FormField\n                // @ts-expect-error — TS2322\n                control={form.control}\n                name=\"estado\"\n                render={({ field }) => (\n                  <FormItem>\n                    <FormLabel>Estado</FormLabel>\n                    <FormControl>\n                      <Input placeholder=\"UF\" maxLength={2} {...field} />\n                    </FormControl>\n                    <FormMessage />\n                  </FormItem>\n                )}\n              />\n            </div>\n\n            <FormField\n              // @ts-expect-error — TS2322\n              control={form.control}\n              name=\"observacoes\"\n              render={({ field }) => (\n                <FormItem>\n                  <FormLabel>Observações</FormLabel>\n                  <FormControl>\n                    <Textarea\n                      placeholder=\"Observações sobre o fornecedor\"\n                      className=\"resize-none\"\n                      rows={3}\n                      {...field}\n                    />\n                  </FormControl>\n                  <FormMessage />\n                </FormItem>\n              )}\n            />\n\n            <FormField\n              // @ts-expect-error — TS2322\n              control={form.control}\n              name=\"ativo\"\n              render={({ field }) => (\n                <FormItem className=\"flex items-center justify-between rounded-lg border p-4\">\n                  <div className=\"space-y-0.5\">\n                    <FormLabel className=\"text-base\">\n                      Fornecedor Ativo\n                    </FormLabel>\n                    <div className=\"text-sm text-muted-foreground\">\n                      Desative para interromper temporariamente este fornecedor\n                    </div>\n                  </div>\n                  <FormControl>\n                    <Switch\n                      checked={field.value}\n                      onCheckedChange={field.onChange}\n                    />\n                  </FormControl>\n                </FormItem>\n              )}\n            />\n          </TabsContent>\n\n          <TabsContent value=\"api\" className=\"space-y-6\">\n            <Card>\n              <CardHeader>\n                <CardTitle>Configuração de Integração com API</CardTitle>\n                <CardDescription>\n                  Configure a conexão com a API do fornecedor para envio\n                  automático de pedidos\n                </CardDescription>\n              </CardHeader>\n              <CardContent className=\"space-y-6\">\n                <FormField\n                  // @ts-expect-error — TS2322\n                  control={form.control}\n                  name=\"apiEnabled\"\n                  render={({ field }) => (\n                    <FormItem className=\"flex items-center justify-between rounded-lg border p-4\">\n                      <div className=\"space-y-0.5\">\n                        <FormLabel className=\"text-base\">\n                          Habilitar Integração API\n                        </FormLabel>\n                        <FormDescription>\n                          Ative para permitir envio automático de pedidos via\n                          API do fornecedor\n                        </FormDescription>\n                      </div>\n                      <FormControl>\n                        <Switch\n                          checked={field.value}\n                          onCheckedChange={field.onChange}\n                        />\n                      </FormControl>\n                    </FormItem>\n                  )}\n                />\n\n                {form.watch(\"apiEnabled\") && (\n                  <>\n                    <FormField\n                      // @ts-expect-error — TS2322\n                      control={form.control}\n                      name=\"apiEndpoint\"\n                      render={({ field }) => (\n                        <FormItem>\n                          <FormLabel>Endpoint da API *</FormLabel>\n                          <FormControl>\n                            <Input\n                              placeholder=\"https://api.fornecedor.com/pedidos\"\n                              {...field}\n                            />\n                          </FormControl>\n                          <FormDescription>\n                            URL completa para envio de pedidos\n                          </FormDescription>\n                          <FormMessage />\n                        </FormItem>\n                      )}\n                    />\n\n                    <FormField\n                      // @ts-expect-error — TS2322\n                      control={form.control}\n                      name=\"apiAuthType\"\n                      render={({ field }) => (\n                        <FormItem>\n                          <FormLabel>Tipo de Autenticação *</FormLabel>\n                          <Select\n                            onValueChange={field.onChange}\n                            value={field.value}\n                          >\n                            <FormControl>\n                              <SelectTrigger>\n                                <SelectValue placeholder=\"Selecione o tipo\" />\n                              </SelectTrigger>\n                            </FormControl>\n                            <SelectContent>\n                              <SelectItem value=\"none\">\n                                Sem autenticação\n                              </SelectItem>\n                              <SelectItem value=\"basic\">Basic Auth</SelectItem>\n                              <SelectItem value=\"bearer\">\n                                Bearer Token\n                              </SelectItem>\n                              <SelectItem value=\"api_key\">API Key</SelectItem>\n                            </SelectContent>\n                          </Select>\n                          <FormMessage />\n                        </FormItem>\n                      )}\n                    />\n\n                    {form.watch(\"apiAuthType\") === \"basic\" && (\n                      <div className=\"grid gap-4 md:grid-cols-2\">\n                        <FormField\n                          // @ts-expect-error — TS2322\n                          control={form.control}\n                          name=\"apiUsername\"\n                          render={({ field }) => (\n                            <FormItem>\n                              <FormLabel>Usuário</FormLabel>\n                              <FormControl>\n                                <Input placeholder=\"usuario\" {...field} />\n                              </FormControl>\n                              <FormMessage />\n                            </FormItem>\n                          )}\n                        />\n                        <FormField\n                          // @ts-expect-error — TS2322\n                          control={form.control}\n                          name=\"apiPassword\"\n                          render={({ field }) => (\n                            <FormItem>\n                              <FormLabel>Senha</FormLabel>\n                              <FormControl>\n                                <Input\n                                  type=\"password\"\n                                  placeholder=\"••••••••\"\n                                  {...field}\n                                />\n                              </FormControl>\n                              <FormMessage />\n                            </FormItem>\n                          )}\n                        />\n                      </div>\n                    )}\n\n                    {form.watch(\"apiAuthType\") === \"bearer\" && (\n                      <FormField\n                        // @ts-expect-error — TS2322\n                        control={form.control}\n                        name=\"apiToken\"\n                        render={({ field }) => (\n                          <FormItem>\n                            <FormLabel>Bearer Token</FormLabel>\n                            <FormControl>\n                              <Input\n                                placeholder=\"eyJhbGciOiJIUzI1NiIsInR5...\"\n                                {...field}\n                              />\n                            </FormControl>\n                            <FormMessage />\n                          </FormItem>\n                        )}\n                      />\n                    )}\n\n                    {form.watch(\"apiAuthType\") === \"api_key\" && (\n                      <div className=\"grid gap-4 md:grid-cols-2\">\n                        <FormField\n                          // @ts-expect-error — TS2322\n                          control={form.control}\n                          name=\"apiKeyHeader\"\n                          render={({ field }) => (\n                            <FormItem>\n                              <FormLabel>Nome do Header</FormLabel>\n                              <FormControl>\n                                <Input placeholder=\"X-API-Key\" {...field} />\n                              </FormControl>\n                              <FormMessage />\n                            </FormItem>\n                          )}\n                        />\n                        <FormField\n                          // @ts-expect-error — TS2322\n                          control={form.control}\n                          name=\"apiKeyValue\"\n                          render={({ field }) => (\n                            <FormItem>\n                              <FormLabel>Valor da API Key</FormLabel>\n                              <FormControl>\n                                <Input\n                                  type=\"password\"\n                                  placeholder=\"sk_live_...\"\n                                  {...field}\n                                />\n                              </FormControl>\n                              <FormMessage />\n                            </FormItem>\n                          )}\n                        />\n                      </div>\n                    )}\n\n                    <FormField\n                      // @ts-expect-error — TS2322\n                      control={form.control}\n                      name=\"apiRequestFormat\"\n                      render={({ field }) => (\n                        <FormItem>\n                          <FormLabel>Formato da Requisição</FormLabel>\n                          <Select\n                            onValueChange={field.onChange}\n                            value={field.value}\n                          >\n                            <FormControl>\n                              <SelectTrigger>\n                                <SelectValue placeholder=\"Selecione o formato\" />\n                              </SelectTrigger>\n                            </FormControl>\n                            <SelectContent>\n                              <SelectItem value=\"json\">JSON</SelectItem>\n                              <SelectItem value=\"xml\">XML</SelectItem>\n                              <SelectItem value=\"form\">Form Data</SelectItem>\n                            </SelectContent>\n                          </Select>\n                          <FormMessage />\n                        </FormItem>\n                      )}\n                    />\n                  </>\n                )}\n              </CardContent>\n            </Card>\n          </TabsContent>\n\n          <TabsContent value=\"pedidos\" className=\"space-y-6\">\n            <Card>\n              <CardHeader>\n                <CardTitle>Pedidos Automáticos</CardTitle>\n                <CardDescription>\n                  Configure o envio automático de pedidos quando produtos\n                  atingirem estoque mínimo\n                </CardDescription>\n              </CardHeader>\n              <CardContent>\n                <FormField\n                  // @ts-expect-error — TS2322\n                  control={form.control}\n                  name=\"autoOrderEnabled\"\n                  render={({ field }) => (\n                    <FormItem className=\"flex items-center justify-between rounded-lg border p-4\">\n                      <div className=\"space-y-0.5\">\n                        <FormLabel className=\"text-base\">\n                          Habilitar Pedidos Automáticos\n                        </FormLabel>\n                        <FormDescription>\n                          Quando ativado, pedidos serão enviados automaticamente\n                          via API quando produtos atingirem estoque mínimo\n                        </FormDescription>\n                      </div>\n                      <FormControl>\n                        <Switch\n                          checked={field.value}\n                          onCheckedChange={field.onChange}\n                          disabled={!form.watch(\"apiEnabled\")}\n                        />\n                      </FormControl>\n                    </FormItem>\n                  )}\n                />\n\n                {!form.watch(\"apiEnabled\") && (\n                  <p className=\"text-sm text-muted-foreground mt-2\">\n                    Configure a integração com a API primeiro para habilitar\n                    pedidos automáticos\n                  </p>\n                )}\n              </CardContent>\n            </Card>\n          </TabsContent>\n        </Tabs>\n\n        <div className=\"flex justify-end gap-3\">\n          <Button type=\"button\" variant=\"outline\" onClick={onCancel}>\n            Cancelar\n          </Button>\n          <Button type=\"submit\">\n            {fornecedor ? \"Atualizar\" : \"Cadastrar\"}\n          </Button>\n        </div>\n      </form>\n    </Form>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/home/heosphoros/Projects/OrthoPlus-Enterprise/apps/web/src/modules/estoque/components/FornecedoresList.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/heosphoros/Projects/OrthoPlus-Enterprise/apps/web/src/modules/estoque/components/InventarioAgendamentoForm.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/heosphoros/Projects/OrthoPlus-Enterprise/apps/web/src/modules/estoque/components/InventarioContagemDialog.tsx","messages":[],"suppressedMessages":[{"ruleId":"@typescript-eslint/no-empty-function","severity":1,"message":"Unexpected empty arrow function.","line":66,"column":70,"messageId":"unexpected","endLine":66,"endColumn":72,"suggestions":[{"messageId":"suggestComment","data":{"name":"arrow function"},"fix":{"range":[1808,1808],"text":" /* empty */ "},"desc":"Add comment inside empty arrow function."}],"suppressions":[{"kind":"directive","justification":""}]}],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/heosphoros/Projects/OrthoPlus-Enterprise/a