orm.handleSubmit(onSubmit)} className=\"space-y-6\">\n        <div className=\"grid gap-6 md:grid-cols-2\">\n          <FormField\n            control={form.control}\n            name=\"tipo\"\n            render={({ field }) => (\n              <FormItem>\n                <FormLabel>Tipo de Movimentação *</FormLabel>\n                <Select\n                  onValueChange={field.onChange}\n                  defaultValue={field.value}\n                >\n                  <FormControl>\n                    <SelectTrigger>\n                      <SelectValue placeholder=\"Selecione o tipo\" />\n                    </SelectTrigger>\n                  </FormControl>\n                  <SelectContent>\n                    {tiposMovimentacao.map((tipo) => (\n                      <SelectItem key={tipo.value} value={tipo.value}>\n                        {tipo.label}\n                      </SelectItem>\n                    ))}\n                  </SelectContent>\n                </Select>\n                <FormMessage />\n              </FormItem>\n            )}\n          />\n\n          <FormField\n            control={form.control}\n            name=\"produtoId\"\n            render={({ field }) => (\n              <FormItem>\n                <FormLabel>Produto *</FormLabel>\n                <Select\n                  onValueChange={field.onChange}\n                  defaultValue={field.value}\n                >\n                  <FormControl>\n                    <SelectTrigger>\n                      <SelectValue placeholder=\"Selecione o produto\" />\n                    </SelectTrigger>\n                  </FormControl>\n                  <SelectContent>\n                    {produtos\n                      .filter((p) => p.ativo)\n                      .map((prod) => (\n                        <SelectItem key={prod.id} value={prod.id!}>\n                          {prod.nome}\n                        </SelectItem>\n                      ))}\n                  </SelectContent>\n                </Select>\n                <FormMessage />\n              </FormItem>\n            )}\n          />\n\n          <FormField\n            control={form.control}\n            name=\"quantidade\"\n            render={({ field }) => (\n              <FormItem>\n                <FormLabel>Quantidade *</FormLabel>\n                <FormControl>\n                  <Input\n                    type=\"number\"\n                    min=\"1\"\n                    placeholder=\"0\"\n                    {...field}\n                    onChange={(e) => field.onChange(Number(e.target.value))}\n                  />\n                </FormControl>\n                <FormMessage />\n              </FormItem>\n            )}\n          />\n\n          <FormField\n            control={form.control}\n            name=\"lote\"\n            render={({ field }) => (\n              <FormItem>\n                <FormLabel>Lote</FormLabel>\n                <FormControl>\n                  <Input placeholder=\"Número do lote\" {...field} />\n                </FormControl>\n                <FormMessage />\n              </FormItem>\n            )}\n          />\n\n          {(tipoMovimentacao === \"ENTRADA\" ||\n            tipoMovimentacao === \"DEVOLUCAO\") && (\n            <>\n              <FormField\n                control={form.control}\n                name=\"dataValidade\"\n                render={({ field }) => (\n                  <FormItem>\n                    <FormLabel>Data de Validade</FormLabel>\n                    <FormControl>\n                      <Input type=\"date\" {...field} />\n                    </FormControl>\n                    <FormMessage />\n                  </FormItem>\n                )}\n              />\n\n              <FormField\n                control={form.control}\n                name=\"fornecedorId\"\n                render={({ field }) => (\n                  <FormItem>\n                    <FormLabel>Fornecedor</FormLabel>\n                    <Select\n                      onValueChange={field.onChange}\n                      defaultValue={field.value}\n                    >\n                      <FormControl>\n                        <SelectTrigger>\n                          <SelectValue placeholder=\"Selecione o fornecedor\" />\n                        </SelectTrigger>\n                      </FormControl>\n                      <SelectContent>\n                        {fornecedores\n                          .filter((f) => f.ativo)\n                          .map((forn) => (\n                            <SelectItem key={forn.id} value={forn.id!}>\n                              {forn.nome}\n                            </SelectItem>\n                          ))}\n                      </SelectContent>\n                    </Select>\n                    <FormMessage />\n                  </FormItem>\n                )}\n              />\n\n              <FormField\n                control={form.control}\n                name=\"notaFiscal\"\n                render={({ field }) => (\n                  <FormItem>\n                    <FormLabel>Nota Fiscal</FormLabel>\n                    <FormControl>\n                      <Input placeholder=\"Número da NF\" {...field} />\n                    </FormControl>\n                    <FormMessage />\n                  </FormItem>\n                )}\n              />\n\n              <FormField\n                control={form.control}\n                name=\"valorUnitario\"\n                render={({ field }) => (\n                  <FormItem>\n                    <FormLabel>Valor Unitário</FormLabel>\n                    <FormControl>\n                      <Input\n                        type=\"number\"\n                        step=\"0.01\"\n                        placeholder=\"0.00\"\n                        {...field}\n                        onChange={(e) => field.onChange(Number(e.target.value))}\n                      />\n                    </FormControl>\n                    <FormMessage />\n                  </FormItem>\n                )}\n              />\n\n              <FormField\n                control={form.control}\n                name=\"valorTotal\"\n                render={({ field }) => (\n                  <FormItem>\n                    <FormLabel>Valor Total</FormLabel>\n                    <FormControl>\n                      <Input\n                        type=\"number\"\n                        step=\"0.01\"\n                        placeholder=\"0.00\"\n                        disabled\n                        {...field}\n                      />\n                    </FormControl>\n                    <FormMessage />\n                  </FormItem>\n                )}\n              />\n            </>\n          )}\n        </div>\n\n        <FormField\n          control={form.control}\n          name=\"motivo\"\n          render={({ field }) => (\n            <FormItem>\n              <FormLabel>Motivo *</FormLabel>\n              <FormControl>\n                <Textarea\n                  placeholder=\"Descreva o motivo da movimentação\"\n                  className=\"resize-none\"\n                  rows={3}\n                  {...field}\n                />\n              </FormControl>\n              <FormMessage />\n            </FormItem>\n          )}\n        />\n\n        <FormField\n          control={form.control}\n          name=\"observacoes\"\n          render={({ field }) => (\n            <FormItem>\n              <FormLabel>Observações</FormLabel>\n              <FormControl>\n                <Textarea\n                  placeholder=\"Observações adicionais\"\n                  className=\"resize-none\"\n                  rows={2}\n                  {...field}\n                />\n              </FormControl>\n              <FormMessage />\n            </FormItem>\n          )}\n        />\n\n        <div className=\"flex justify-end gap-3\">\n          <Button type=\"button\" variant=\"outline\" onClick={onCancel}>\n            Cancelar\n          </Button>\n          <Button type=\"submit\">Registrar Movimentação</Button>\n        </div>\n      </form>\n    </Form>\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"/home/heosphoros/Projects/OrthoPlus-Enterprise/apps/web/src/modules/estoque/components/MovimentacoesList.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/home/heosphoros/Projects/OrthoPlus-Enterprise/apps/web/src/modules/estoque/components/PedidoConfigForm.tsx","messages":[{"ruleId":"react-hooks/incompatible-library","severity":1,"message":"Compilation Skipped: Use of incompatible library\n\nThis API returns functions which cannot be memoized without leading to stale UI. To prevent this, by default React Compiler will skip memoizing this component/hook. However, you may see issues if values from this API are passed to other components/hooks that are memoized.\n\n/home/heosphoros/Projects/OrthoPlus-Enterprise/apps/web/src/modules/estoque/components/PedidoConfigForm.tsx:50:29\n  48 |   });\n  49 |\n> 50 |   const selectedProdutoId = watch(\"produtoId\");\n     |                             ^^^^^ React Hook Form's `useForm()` API returns a `watch()` function which cannot be memoized safely.\n  51 |   const selectedProduto = produtos.find((p) => p.id === selectedProdutoId);\n  52 |\n  53 |   return (","line":50,"column":29,"endLine":50,"endColumn":34}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useForm } from \"react-hook-form\";\nimport { zodResolver } from \"@hookform/resolvers/zod\";\nimport { Button } from \"@orthoplus/core-ui/button\";\nimport { Input } from \"@orthoplus/core-ui/input\";\nimport { Label } from \"@orthoplus/core-ui/label\";\nimport { Switch } fr