alue(\"diasTrabalho\", updated);\n  };\n\n  const handlePermissoesChange = (novasPermissoes: Permissoes) => {\n    setPermissoes(novasPermissoes);\n    setValue(\"permissoes\", novasPermissoes);\n  };\n\n  const handleFormSubmit = (data: Funcionario) => {\n    onSubmit({\n      ...data,\n      diasTrabalho: selectedDias,\n      permissoes: permissoes,\n      avatar_url: avatarUrl,\n    });\n  };\n\n  return (\n    <form onSubmit={handleSubmit(handleFormSubmit)} className=\"space-y-6\">\n      {/* Avatar */}\n      <div className=\"flex justify-center py-4\">\n        <AvatarUpload\n          currentAvatarUrl={avatarUrl}\n          onAvatarChange={setAvatarUrl}\n          fallbackText={funcionario?.nome.substring(0, 2).toUpperCase() || \"FN\"}\n          size=\"xl\"\n        />\n      </div>\n\n      <Tabs defaultValue=\"pessoal\" className=\"w-full\">\n        <TabsList className=\"grid w-full grid-cols-5\">\n          <TabsTrigger value=\"pessoal\">Pessoal</TabsTrigger>\n          <TabsTrigger value=\"contato\">Contato</TabsTrigger>\n          <TabsTrigger value=\"profissional\">Profissional</TabsTrigger>\n          <TabsTrigger value=\"horarios\">Horários</TabsTrigger>\n          <TabsTrigger value=\"permissoes\">Permissões</TabsTrigger>\n        </TabsList>\n\n        {/* Dados Pessoais */}\n        <TabsContent value=\"pessoal\" className=\"space-y-4\">\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n            <div className=\"md:col-span-2 space-y-2\">\n              <Label htmlFor=\"nome\">Nome Completo *</Label>\n              <Input\n                id=\"nome\"\n                {...register(\"nome\")}\n                placeholder=\"Nome completo do funcionário\"\n                className={errors.nome ? \"border-destructive\" : \"\"}\n              />\n              {errors.nome && (\n                <p className=\"text-sm text-destructive\">\n                  {errors.nome.message}\n                </p>\n              )}\n            </div>\n\n            <div className=\"space-y-2\">\n              <Label htmlFor=\"cpf\">CPF *</Label>\n              <Input\n                id=\"cpf\"\n                {...register(\"cpf\")}\n                placeholder=\"000.000.000-00\"\n                className={errors.cpf ? \"border-destructive\" : \"\"}\n              />\n              {errors.cpf && (\n                <p className=\"text-sm text-destructive\">{errors.cpf.message}</p>\n              )}\n            </div>\n\n            <div className=\"space-y-2\">\n              <Label htmlFor=\"rg\">RG</Label>\n              <Input id=\"rg\" {...register(\"rg\")} placeholder=\"00.000.000-0\" />\n            </div>\n\n            <div className=\"space-y-2\">\n              <Label>Data de Nascimento *</Label>\n              <Popover>\n                <PopoverTrigger asChild>\n                  <Button\n                    variant=\"outline\"\n                    className={cn(\n                      \"w-full justify-start text-left font-normal\",\n                      !dataNascimento && \"text-muted-foreground\",\n                      errors.dataNascimento && \"border-destructive\",\n                    )}\n                  >\n                    <CalendarIcon className=\"mr-2 h-4 w-4\" />\n                    {dataNascimento\n                      ? format(new Date(dataNascimento), \"PPP\", {\n                          locale: ptBR,\n                        })\n                      : \"Selecione a data\"}\n                  </Button>\n                </PopoverTrigger>\n                <PopoverContent className=\"w-auto p-0\" align=\"start\">\n                  <Calendar\n                    mode=\"single\"\n                    selected={\n                      dataNascimento ? new Date(dataNascimento) : undefined\n                    }\n                    onSelect={(date) =>\n                      date &&\n                      setValue(\"dataNascimento\", format(date, \"yyyy-MM-dd\"))\n                    }\n                    disabled={(date) => date > new Date()}\n                    initialFocus\n                    className=\"pointer-events-auto\"\n                  />\n                </PopoverContent>\n              </Popover>\n              {errors.dataNascimento && (\n                <p className=\"text-sm text-destructive\">\n                  {errors.dataNascimento.message}\n                </p>\n              )}\n            </div>\n\n            <div className=\"space-y-2\">\n              <Label htmlFor=\"sexo\">Sexo *</Label>\n              <Select\n                value={watch(\"sexo\")}\n                onValueChange={(value) =>\n                  setValue(\"sexo\", value as \"M\" | \"F\" | \"Outro\")\n                }\n              >\n                <SelectTrigger\n                  className={errors.sexo ? \"border-destructive\" : \"\"}\n                >\n                  <SelectValue placeholder=\"Selecione\" />\n                </SelectTrigger>\n                <SelectContent>\n                  <SelectItem value=\"M\">Masculino</SelectItem>\n                  <SelectItem value=\"F\">Feminino</SelectItem>\n                  <SelectItem value=\"Outro\">Outro</SelectItem>\n                </SelectContent>\n              </Select>\n              {errors.sexo && (\n                <p className=\"text-sm text-destructive\">\n                  {errors.sexo.message}\n                </p>\n              )}\n            </div>\n          </div>\n        </TabsContent>\n\n        {/* Contato */}\n        <TabsContent value=\"contato\" className=\"space-y-4\">\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n            <div className=\"space-y-2\">\n              <Label htmlFor=\"telefone\">Telefone *</Label>\n              <Input\n                id=\"telefone\"\n                {...register(\"telefone\")}\n                placeholder=\"(00) 0000-0000\"\n                className={errors.telefone ? \"border-destructive\