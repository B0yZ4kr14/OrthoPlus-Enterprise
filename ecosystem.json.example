{
  "apps": [
    {
      "name": "orthoplus-backend",
      "script": "/data/home/ubuntu/OrthoPlus/backend/dist/index.js",
      "instances": 2,
      "exec_mode": "cluster",
      "cwd": "/data/home/ubuntu/OrthoPlus",
      "max_memory_restart": "500M",
      "restart_delay": 3000,
      "max_restarts": 10,
      "min_uptime": "10s",
      "output": "/data/home/ubuntu/OrthoPlus/logs/backend-out.log",
      "error_file": "/data/home/ubuntu/OrthoPlus/logs/backend-err.log",
      "log_date_format": "YYYY-MM-DD HH:mm:ss Z",
      "merge_logs": true,
      "env": {
        "NODE_ENV": "production",
        "PORT": "3005",
        "LOG_LEVEL": "info",
        "JWT_SECRET": "<generate-with-openssl-rand-base64-32>",
        "AUTH_ALLOW_MOCK": "false",
        "ENABLE_DANGEROUS_ADMIN_ENDPOINTS": "false",
        "DB_HOST": "127.0.0.1",
        "DB_PORT": "5432",
        "DB_NAME": "orthoplus",
        "DB_USER": "orthoplus",
        "DB_PASSWORD": "<your-db-password>",
        "DB_SSL": "false",
        "DATABASE_URL": "postgresql://<user>:<password>@127.0.0.1:5432/orthoplus?search_path=public,configuracoes,pacientes,inventario,pdv,financeiro,pep,faturamento,database_admin,backups,crypto_config,github_tools,terminal",
        "REDIS_URL": "redis://:<password>@127.0.0.1:6379",
        "REDIS_PASSWORD": "<your-redis-password>",
        "ALLOWED_ORIGINS": "https://your-domain.com",
        "OPENROUTER_API_KEY": "<your-openrouter-key>",
        "OPENROUTER_MODEL": "google/gemini-2.0-flash-exp:free",
        "GEMINI_API_KEY": "",
        "AGENT_MODEL": "gemini-2.0-flash",
        "ENABLE_MODEL_ROUTING": "true",
        "ROUTING_STRATEGY": "fallback",
        "API_PORT": "8000",
        "API_HOST": "127.0.0.1",
        "COOKIE_SECURE": "false",
        "HOST": "127.0.0.1"
      }
    }
  ]
}
