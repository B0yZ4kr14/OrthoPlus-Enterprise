{
  "name": "@orthoplus/monorepo",
  "private": true,
  "version": "5.5.0",
  "type": "module",
  "workspaces": [
    "categories/@orthoplus/*",
    "categories/@orthoplus/*/packages/*",
    "apps/*",
    "backend",
    "shared-types"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "guard": "node scripts/guard.cjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.16.5",
    "eslint": "^10.1.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "playwright": "^1.60.0",
    "prettier": "^3.8.1",
    "tailwindcss-animate": "^1.0.7",
    "ts-morph": "^28.0.0",
    "tsx": "^4.21.0",
    "turbo": "^2.0.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.58.0"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "@swc/core",
      "bcrypt",
      "better-sqlite3",
      "canvas",
      "core-js",
      "esbuild",
      "msgpackr-extract",
      "prisma"
    ],
    "overrides": {
      "dompurify": ">=3.4.0",
      "vite@>=8.0.0 <=8.0.4": ">=8.0.5",
      "postcss@<8.5.10": ">=8.5.10",
      "brace-expansion@>=5.0.0 <5.0.6": ">=5.0.6",
      "ws@>=8.0.0 <8.20.1": ">=8.20.1",
      "turbo@<=2.9.13": ">=2.9.14",
      "turbo@>=1.1.0 <2.9.14": ">=2.9.14",
      "uuid@<11.1.1": ">=11.1.1",
      "qs@>=6.11.1 <=6.15.1": ">=6.15.2",
      "tmp@<0.2.6": ">=0.2.6"
    }
  }
}
