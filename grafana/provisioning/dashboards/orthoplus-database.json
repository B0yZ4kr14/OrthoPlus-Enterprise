{
  "id": null,
  "uid": "orthoplus-database-observability",
  "title": "OrthoPlus \u2014 Database Observability",
  "tags": [
    "database",
    "observability",
    "devsecops"
  ],
  "timezone": "America/Sao_Paulo",
  "schemaVersion": 36,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "Circuit Breaker State",
      "type": "stat",
      "targets": [
        {
          "expr": "orthoplus_circuit_breaker_state",
          "legendFormat": "{{category}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "text": "CLOSED",
                  "color": "green"
                }
              },
              "type": "value"
            },
            {
              "options": {
                "1": {
                  "text": "HALF_OPEN",
                  "color": "yellow"
                }
              },
              "type": "value"
            },
            {
              "options": {
                "2": {
                  "text": "OPEN",
                  "color": "red"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 2
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      }
    },
    {
      "id": 2,
      "title": "DB Health Status",
      "type": "stat",
      "targets": [
        {
          "expr": "orthoplus_db_category_health",
          "legendFormat": "{{category}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                }
              },
              "type": "value"
            },
            {
              "options": {
                "1": {
                  "text": "DEGRADED",
                  "color": "yellow"
                }
              },
              "type": "value"
            },
            {
              "options": {
                "2": {
                  "text": "HEALTHY",
                  "color": "green"
                }
              },
              "type": "value"
            }
          ]
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      }
    },
    {
      "id": 3,
      "title": "DB Category Latency (ms)",
      "type": "graph",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(orthoplus_db_category_latency_ms_bucket[5m])) by (le, category))",
          "legendFormat": "p95 {{category}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(orthoplus_db_category_latency_ms_bucket[5m])) by (le, category))",
          "legendFormat": "p50 {{category}}",
          "refId": "B"
        }
      ],
      "yAxes": [
        {
          "label": "ms",
          "min": 0
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      }
    },
    {
      "id": 4,
      "title": "Database Size by Category",
      "type": "graph",
      "targets": [
        {
          "expr": "orthoplus_db_category_size_bytes",
          "legendFormat": "{{category}}",
          "refId": "A"
        }
      ],
      "yAxes": [
        {
          "label": "Bytes",
          "min": 0
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      }
    },
    {
      "id": 5,
      "title": "Table Count by Category",
      "type": "stat",
      "targets": [
        {
          "expr": "orthoplus_db_category_tables",
          "legendFormat": "{{category}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      }
    },
    {
      "id": 6,
      "title": "Backup Duration (seconds)",
      "type": "graph",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(orthoplus_backup_duration_seconds_bucket[1h])) by (le, category))",
          "legendFormat": "p95 {{category}}",
          "refId": "A"
        }
      ],
      "yAxes": [
        {
          "label": "s",
          "min": 0
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      }
    },
    {
      "id": 7,
      "title": "Backup Success / Failure",
      "type": "graph",
      "targets": [
        {
          "expr": "rate(orthoplus_backup_success_total[1h])",
          "legendFormat": "success {{category}}",
          "refId": "A"
        },
        {
          "expr": "rate(orthoplus_backup_failure_total[1h])",
          "legendFormat": "failure {{category}}",
          "refId": "B"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      }
    },
    {
      "id": 8,
      "title": "Rejected Calls (Circuit Breaker)",
      "type": "graph",
      "targets": [
        {
          "expr": "rate(orthoplus_circuit_breaker_rejected_calls_total[5m])",
          "legendFormat": "{{category}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 32
      }
    },
    {
      "id": 9,
      "title": "Circuit Breaker Failures",
      "type": "graph",
      "targets": [
        {
          "expr": "rate(orthoplus_circuit_breaker_failures_total[5m])",
          "legendFormat": "{{category}}",
          "refId": "A"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 40
      }
    }
  ]
}