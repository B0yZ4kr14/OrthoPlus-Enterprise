# API Configuration
# Copy this file to .env and fill in your values
VITE_API_BASE_URL="http://localhost:3000/api"
JWT_SECRET="<REMOVED>"
DB_HOST="localhost"
DB_PORT="5432"
DB_NAME="orthoplus"
DB_USER="postgres"
DB_PASSWORD="<REMOVED>"
POSTGRES_PASSWORD="${DB_PASSWORD}"
SEED_ADMIN_PASSWORD=change-me-min-8-chars
DATABASE_URL="postgresql://<REMOVED><user>:<password>@localhost:5432/orthoplus?schema=public"
REDIS_URL="redis://localhost:6379"

# Grafana (REQUIRED — no default fallback)
GRAFANA_PASSWORD=
