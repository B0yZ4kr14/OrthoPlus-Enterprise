# API Configuration
# Copy this file to .env and fill in your values
VITE_API_BASE_URL="http://localhost:3005/api"
JWT_SECRET="<REMOVED>"
DB_HOST="localhost"
DB_PORT="5432"
DB_NAME="orthoplus"
DB_USER="postgres"
DB_PASSWORD="<REMOVED>"
POSTGRES_PASSWORD="${DB_PASSWORD}"
SEED_ADMIN_PASSWORD=change-me-min-8-chars
DATABASE_URL="postgresql://<REMOVED><user>:<password>@localhost:5432/orthoplus?schema=public"
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=change-me-redis-password

# Grafana (REQUIRED — no default fallback)
GRAFANA_PASSWORD=

# IA Radiografia (Medical AI Analysis — disabled by default)
ENABLE_AI_RADIOGRAPHY=false
AI_LOCAL_ENDPOINT=http://localhost:11434
AI_LOCAL_MODEL=llava

# IA Radiografia Encryption (REQUIRED when enabled — min 32 chars)
IA_ENCRYPTION_KEY=change-me-to-a-32-char-minimum-secret-key

# Search Index Cron
SEARCH_INDEX_CRON_ENABLED=true

# Search Index Rate Limiting
SEARCH_RATE_LIMIT_PER_MINUTE=30
SEARCH_RATE_LIMIT_VIP_PER_MINUTE=100
SEARCH_RATE_LIMIT_VIP_CLINIC_IDS=

# Memory Hub
MEMORY_HUB_ENABLED=true
MEMORY_HUB_INDEX_PATH=.memory-hub/index.db
MEMORY_HUB_OLLAMA_MODEL=nomic-embed-text
MEMORY_HUB_WATCH_DIRS=specs/,docs/,categories/
MEMORY_HUB_POLLING_INTERVAL_MS=30000
MEMORY_HUB_DRIFT_SCAN_CRON=0 2 * * *
MEMORY_HUB_USE_POLLING=false       # Fallback to polling when inotify is unavailable (Docker, NFS, WSL)

# Agent Service CORS (comma-separated origins; NEVER use * in production)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Server Configuration
NODE_ENV=development
PORT=3005
LOG_LEVEL=info

# Security Flags (MUST be false in production)
AUTH_ALLOW_MOCK=false
ENABLE_DANGEROUS_ADMIN_ENDPOINTS=false

# Database SSL
DB_SSL=false

# Nginx
NGINX_SERVER_NAME=localhost

# Email (Resend)
RESEND_API_KEY=

# SMTP (optional — fallback email provider)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@orthoplus.com

# Video Call (Agora — optional)
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# ─── Agent Service ────────────────────────────────────────────────────────────
AGENT_SERVICE_URL=http://localhost:8000
AGENT_SERVICE_TIMEOUT=30000

# ─── Agora (Video Calls) ──────────────────────────────────────────────────────
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=

# ─── AI / LLM ─────────────────────────────────────────────────────────────────
AI_GATEWAY_API_KEY=
VERCEL_AI_GATEWAY_API_KEY=

# ─── CORS / URLs ──────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
API_BASE_URL=http://localhost:3005
BACKEND_URL=http://localhost:3005
FRONTEND_URL=http://localhost:3000

# ─── Backups ──────────────────────────────────────────────────────────────────
BACKUP_DIR=./backups

# ─── Security ─────────────────────────────────────────────────────────────────
BLOCKED_FILE_HASHES=
CRON_SECRET=<generate-with-openssl-rand-base64-32>

# ─── Crypto ───────────────────────────────────────────────────────────────────
CRYPTO_EXCHANGE_API=

# ─── Database ─────────────────────────────────────────────────────────────────
DB_SCHEMA=public

# ─── GitHub ───────────────────────────────────────────────────────────────────
GITHUB_TOKEN=

# ─── Memory Hub ───────────────────────────────────────────────────────────────
MEMORY_HUB_ENABLED=false
MEMORY_HUB_API_BASE_URL=
MEMORY_HUB_API_KEY=
MEMORY_HUB_COMPRESSION=true
MEMORY_HUB_DEFAULT_BUDGET_USD=10
MEMORY_HUB_DRIFT_TIMEOUT=30000
MEMORY_HUB_EMBEDDING_MODEL=text-embedding-3-small
MEMORY_HUB_EMBEDDING_PROVIDER=openai
MEMORY_HUB_MASTER_KEY=
MEMORY_HUB_PROJECT_ROOT=
MEMORY_HUB_USE_POLLING=false
MEMORY_HUB_POLLING_INTERVAL_MS=5000
MEMORY_HUB_OLLAMA_MODEL=llama3.1

# ─── Mock Auth (DEV ONLY) ─────────────────────────────────────────────────────
MOCK_ADMIN_EMAIL=admin@orthoplus.com
MOCK_ADMIN_PASSWORD=change-me-min-8-chars

# ─── Redis Cluster ────────────────────────────────────────────────────────────
REDIS_CLUSTER_MODE=false
REDIS_CLUSTER_NODES=

# ─── SMTP ─────────────────────────────────────────────────────────────────────
SMTP_SECURE=true
