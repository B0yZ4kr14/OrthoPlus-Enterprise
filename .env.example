# API Configuration
# Copy this file to .env and fill in your values
VITE_API_BASE_URL="http://localhost:3000/api"
JWT_SECRET="<REMOVED>"
DB_HOST="localhost"
DB_PORT="5432"
DB_NAME="orthoplus"
DB_USER="postgres"
DB_PASSWORD="<REMOVED>"
POSTGRES_PASSWORD="${DB_PASSWORD}"
SEED_ADMIN_PASSWORD=change-me-min-8-chars
DATABASE_URL="postgresql://<REMOVED><user>:<password>@localhost:5432/orthoplus?schema=public"
REDIS_URL="redis://localhost:6379"

# Grafana (REQUIRED — no default fallback)
GRAFANA_PASSWORD=

# IA Radiografia (Medical AI Analysis — disabled by default)
ENABLE_AI_RADIOGRAPHY=false
AI_LOCAL_ENDPOINT=http://localhost:11434
AI_LOCAL_MODEL=llava

# IA Radiografia Encryption (REQUIRED when enabled — min 32 chars)
IA_ENCRYPTION_KEY=change-me-to-a-32-char-minimum-secret-key

# Search Index Cron
SEARCH_INDEX_CRON_ENABLED=true

# Search Index Rate Limiting
SEARCH_RATE_LIMIT_PER_MINUTE=30
SEARCH_RATE_LIMIT_VIP_PER_MINUTE=100
SEARCH_RATE_LIMIT_VIP_CLINIC_IDS=

# Memory Hub
MEMORY_HUB_ENABLED=true
MEMORY_HUB_INDEX_PATH=.memory-hub/index.db
MEMORY_HUB_OLLAMA_MODEL=nomic-embed-text
MEMORY_HUB_WATCH_DIRS=specs/,docs/,categories/
MEMORY_HUB_POLLING_INTERVAL_MS=30000
MEMORY_HUB_DRIFT_SCAN_CRON=0 2 * * *
MEMORY_HUB_USE_POLLING=false       # Fallback to polling when inotify is unavailable (Docker, NFS, WSL)
