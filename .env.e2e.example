# OrthoPlus — E2E / Test Environment Variables Example
# Copy this file to .env.e2e and fill in real values for local E2E runs.
# NEVER commit .env.e2e to version control.

# Admin account used by Playwright global-setup.ts
E2E_ADMIN_EMAIL=admin@orthoplus.com
E2E_ADMIN_PASSWORD=change-me-strong-password

# Ephemeral database credentials (CI runner only)
E2E_DB_PASSWORD=change-me-db-password
E2E_DATABASE_URL=postgresql://orthoplus:change-me-db-password@localhost:5432/orthoplus
E2E_POSTGRES_PASSWORD=change-me-db-password

# IA Radiografia test encryption key (min 32 chars)
E2E_IA_ENCRYPTION_KEY=change-me-to-a-32-char-minimum-secret-key
